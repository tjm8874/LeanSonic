/-
  LeanSonic — Verified Constant & Header Emitter (`Emit.lean`)
  ============================================================================
  Because `LeanSonic.Proofs.Inkling2Mini` is imported here, this executable
  CANNOT compile unless every Phase 0 & Phase 1 proof type-checks in the Lean 4
  kernel. Running `lake exe leansonic-gen` emits synchronized, machine-verified
  constants for both the Rust runtime (`generated_spec.rs`) and the Blackwell
  CUDA/PTX templates (`leansonic_verified.cuh`).
-/

import LeanSonic.Axioms
import LeanSonic.Proofs.Inkling2Mini

open LeanSonic
open LeanSonic.Proofs

def renderIntList (xs : List Int) : String :=
  String.intercalate ", " (xs.map toString)

def emitRustSpec : String :=
  let p := phase1HybridPool
  let lut := e2m1BytePermLut.toList
  String.intercalate "\n"
    [ "// @generated by `lake exe leansonic-gen` from `spec/LeanSonic/Proofs/Inkling2Mini.lean`."
    , "// DO NOT EDIT MANUALLY — CI Gate 1 enforces `git diff --exit-code` against Lean 4 proofs."
    , ""
    , "pub const SM120_COMBINED_L1_SMEM_KIB: usize = " ++ toString sm120CombinedL1SmemKiB ++ ";"
    , "pub const SM120_MAX_SMEM_PER_SM_BYTES: usize = " ++ toString sm120MaxSmemPerSmBytes ++ ";"
    , "pub const SM120_SYS_RESERVED_SMEM_BYTES: usize = " ++ toString sm120SystemReservedSmemPerCtaBytes ++ ";"
    , "pub const SM120_REGS_PER_SM: usize = " ++ toString sm120RegsPerSm ++ ";"
    , "pub const SM120_MAX_WARPS_PER_SM: usize = " ++ toString sm120MaxWarpsPerSm ++ ";"
    , "pub const SM120_TMA_ALIGNMENT_BYTES: usize = " ++ toString sm120TmaAlignmentBytes ++ ";"
    , ""
    , "pub const INKLING2_MINI_PHYSICAL_LAYERS: usize = " ++ toString inkling2MiniSchedule.physicalLayers ++ ";"
    , "pub const INKLING2_MINI_TOTAL_VISITS: usize = " ++ toString inkling2MiniSchedule.visits.length ++ ";"
    , "pub const INKLING2_MINI_NUM_EXPERTS: usize = 128;"
    , "pub const INKLING2_MINI_TOP_K_EXPERTS: usize = 8;"
    , ""
    , "pub const QWEN38_FLASH_NEXT_PHYSICAL_LAYERS: usize = " ++ toString qwen38FlashNextSchedule.physicalLayers ++ ";"
    , "pub const QWEN38_FLASH_NEXT_NUM_EXPERTS: usize = 512;"
    , "pub const QWEN38_FLASH_NEXT_TOP_K_EXPERTS: usize = 10;"
    , ""
    , "pub const MAX_CONCURRENT_SLOTS: usize = " ++ toString p.maxConcurrentSlots ++ ";"
    , "pub const SPEC_VERIFY_WINDOW: usize = " ++ toString p.specVerifyWindow ++ ";"
    , "pub const MAX_BATCH_ROWS: usize = " ++ toString p.maxBatchRows ++ ";"
    , "pub const KV_BLOCK_ALIGN_TOKENS: usize = " ++ toString p.kvBlockAlignTokens ++ ";"
    , "pub const SWA_WINDOW_TOKENS: usize = " ++ toString p.swaWindowTokens ++ ";"
    , "pub const SWA_RING_CAPACITY_TOKENS: usize = " ++ toString p.swaRingCapacityTokens ++ ";"
    , "pub const RECURRENT_STATE_SLOTS: usize = " ++ toString p.recurrentStateSlots ++ ";"
    , "pub const MOE_GROUPED_MMA_MIN_PAIRS: usize = " ++ toString moeGroupedMmaMinPairs ++ ";"
    , ""
    , "/// Exact doubled (`2x`) NVFP4 `E2M1` lookup table verified in Lean 4 over all 16 4-bit codes."
    , "pub const E2M1_DOUBLED_INT8_LUT: [i8; 16] ="
    , "    [" ++ renderIntList lut ++ "];"
    , ""
    ]

def emitCudaHeader : String :=
  let p := phase1HybridPool
  let lut := e2m1BytePermLut.toList
  String.intercalate "\n"
    [ "// @generated by `lake exe leansonic-gen` from `spec/LeanSonic/Proofs/Inkling2Mini.lean`."
    , "// DO NOT EDIT MANUALLY — CI Gate 1 enforces exact parity with Lean 4 formal proofs."
    , "#pragma once"
    , "#include <stdint.h>"
    , ""
    , "namespace leansonic::verified {"
    , ""
    , "static constexpr uint32_t kSm120MaxSmemPerSmBytes = " ++ toString sm120MaxSmemPerSmBytes ++ "u;"
    , "static constexpr uint32_t kSm120TmaAlignBytes     = " ++ toString sm120TmaAlignmentBytes ++ "u;"
    , "static constexpr uint32_t kMaxConcurrentSlots     = " ++ toString p.maxConcurrentSlots ++ "u;"
    , "static constexpr uint32_t kSpecVerifyWindow       = " ++ toString p.specVerifyWindow ++ "u;"
    , "static constexpr uint32_t kMaxBatchRows           = " ++ toString p.maxBatchRows ++ "u;"
    , "static constexpr uint32_t kKvBlockAlignTokens     = " ++ toString p.kvBlockAlignTokens ++ "u;"
    , "static constexpr uint32_t kSwaWindowTokens        = " ++ toString p.swaWindowTokens ++ "u;"
    , "static constexpr uint32_t kSwaRingCapacityTokens  = " ++ toString p.swaRingCapacityTokens ++ "u;"
    , "static constexpr uint32_t kRecurrentStateSlots    = " ++ toString p.recurrentStateSlots ++ "u;"
    , "static constexpr uint32_t kMoeGroupedMmaMinPairs  = " ++ toString moeGroupedMmaMinPairs ++ "u;"
    , ""
    , "// `attn_blocklist_tc` verified SMEM slice offsets (30,720 B total, 128B aligned, stage-disjoint)"
    , "static constexpr uint32_t kAttnThreadsPerCta      = " ++ toString kAttnBlocklistTc.threadsPerCta ++ "u;"
    , "static constexpr uint32_t kAttnUserSmemBytes      = " ++ toString kAttnBlocklistTc.userSmemPerCtaBytes ++ "u;"
    , "static constexpr uint32_t kAttnSmemOffQTile       = 0u;"
    , "static constexpr uint32_t kAttnSmemOffKvRing      = 4096u;"
    , "static constexpr uint32_t kAttnSmemKvStageBytes   = 6144u;"
    , "static constexpr uint32_t kAttnSmemOffEpilogue    = 4096u;"
    , "static constexpr uint32_t kAttnSmemOffPdlBarriers = 28672u;"
    , ""
    , "// `moe_simt_reg64` & `moe_grouped_mma_int8` verified launch bounds"
    , "static constexpr uint32_t kMoeSimtThreads         = " ++ toString kMoeSimtLowBatch.threadsPerCta ++ "u;"
    , "static constexpr uint32_t kMoeSimtMinCtasPerSm    = " ++ toString kMoeSimtLowBatch.ctasPerSm ++ "u;"
    , "static constexpr uint32_t kMoeMmaThreads          = " ++ toString kMoeGroupedMmaInt8.threadsPerCta ++ "u;"
    , "static constexpr uint32_t kMoeMmaMinCtasPerSm     = " ++ toString kMoeGroupedMmaInt8.ctasPerSm ++ "u;"
    , ""
    , "// Packed `__byte_perm` LUT words for lossless `2x E2M1 -> int8` decoding"
    , "// Codes 0..3:   [0, 1, 2, 3]       -> 0x03020100u"
    , "// Codes 4..7:   [4, 6, 8, 12]      -> 0x0c080604u"
    , "// Codes 8..11:  [0, -1, -2, -3]    -> 0xfdfeff00u"
    , "// Codes 12..15: [-4, -6, -8, -12]  -> 0xf4f8fafcu"
    , "static constexpr int8_t kE2M1DoubledLut[16] = {" ++ renderIntList lut ++ "};"
    , "static constexpr uint32_t kE2M1LutPosLo = 0x03020100u;"
    , "static constexpr uint32_t kE2M1LutPosHi = 0x0c080604u;"
    , "static constexpr uint32_t kE2M1LutNegLo = 0xfdfeff00u;"
    , "static constexpr uint32_t kE2M1LutNegHi = 0xf4f8fafcu;"
    , ""
    , "static_assert(kSwaRingCapacityTokens % kKvBlockAlignTokens == 0, \"SWA ring must be 64-aligned\");"
    , "static_assert(kSwaRingCapacityTokens >= kSwaWindowTokens + kMaxBatchRows, \"SWA ring no-clobber\");"
    , "static_assert(kRecurrentStateSlots >= kMaxConcurrentSlots * (1u + kSpecVerifyWindow), \"GDN slot pool no-clobber\");"
    , ""
    , "} // namespace leansonic::verified"
    , ""
    ]

def main (args : List String) : IO UInt32 := do
  let repoRoot := match args with
    | root :: _ => root
    | [] => ".."
  let rsPath := System.FilePath.mk (repoRoot ++ "/crates/leansonic-core/src/generated_spec.rs")
  let cuhPath := System.FilePath.mk (repoRoot ++ "/kernels/include/leansonic_verified.cuh")
  if let some parent := rsPath.parent then
    IO.FS.createDirAll parent
  if let some parent := cuhPath.parent then
    IO.FS.createDirAll parent
  IO.FS.writeFile rsPath emitRustSpec
  IO.FS.writeFile cuhPath emitCudaHeader
  IO.println s!"[leansonic-gen] Verified proofs OK -> emitted {rsPath} and {cuhPath}"
  return 0
