+static bool trace_node(ggml_tensor * t, bool ask, void *) {
+    if (active_row < 0) return false;
+    std::string n = t->name;
+    if (n.rfind("ffn_moe_topk-",0) && n.rfind("ffn_moe_logits-",0) && n.rfind("ffn_inp-",0) && n.rfind("l_out-",0)) return false;
+    if (ask) return true;
+    int row = active_row;
+    if (row >= t->ne[1] || t->nb[0]!=4 || t->ne[2]!=1 || t->ne[3]!=1) {
+        std::fprintf(stderr,"TRACE_SHAPE %s %ld %ld %ld %ld\n", t->name,t->ne[0],t->ne[1],t->ne[2],t->ne[3]); return true;
+    }
+    auto save=[&](ggml_tensor * src,const std::string& name){
+        static std::map<std::string,int> visits;
+        std::vector<char> buf(src->ne[0]*4);
+        std::string file = std::string(std::getenv("REPLAY_OUT"))+"/"+name+"."+std::to_string(visits[name]++)+".bin";
+        ggml_backend_tensor_get(src,buf.data(),row*src->nb[1],buf.size());
+        std::ofstream f(file,std::ios::binary);f.write(buf.data(),buf.size()); if (!f) std::abort();
+    };
+    save(t,n);
+    if (!n.rfind("ffn_moe_logits-",0) && t->src[1] && t->src[1]->ne[0]==2304 && t->src[1]->ne[1]==t->ne[1] && t->src[1]->nb[0]==4)
+        save(t->src[1],"norm-"+n.substr(15));
+    return true;
+}
 
