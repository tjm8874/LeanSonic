+    fn inspect_verifier_ops(&self,layer:usize,phase:&str,fields:&[(&str,u64,usize)]) -> Result<(),String> {
+        use std::io::Write;
+        let Ok(path)=std::env::var("Q38_TRACE_OUTPUT") else {return Ok(())};
+        self.ctx.sync_compute()?;
+        let mut f=std::fs::OpenOptions::new().create(true).append(true).open(path).map_err(|e|e.to_string())?;
+        for &(name,ptr,len) in fields {
+            let mut bytes=vec![0u8;len*4];
+            unsafe{ check_cu((self.ctx.api.cuMemcpyDtoH_v2)(bytes.as_mut_ptr().cast(),ptr,len*4),"diagnostic read")?; }
+            writeln!(f,"{layer} {phase} {name} {len}").and_then(|_|f.write_all(&bytes)).map_err(|e|e.to_string())?;
+        }
+        Ok(())
+    }
