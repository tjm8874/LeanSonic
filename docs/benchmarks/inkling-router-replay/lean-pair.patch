@@ -0,0 +1,26 @@
+use leansonic_core::inkling2_gpu::Inkling2GpuEngine;
+use std::{env, fs, io::Write};
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let a: Vec<_> = env::args().collect();
+    let ids: Vec<u32> = fs::read_to_string(&a[2])?
+        .trim()
+        .split(',')
+        .map(str::parse)
+        .collect::<Result<_, _>>()?;
+    let n = ids.len();
+    let mut eng = Inkling2GpuEngine::load_from_dir_with_spec(&a[1], 512, false, 0)?;
+    eng.reset()?;
+    eng.prefill_tokens(&ids[..257])?;
+    for &id in &ids[257..n - 1] {
+        eng.forward_greedy_token(id)?;
+    }
+    env::set_var("DIAG_LEAN_ROUTE", &a[3]);
+    let next = eng.forward_greedy_token(ids[n - 1])?;
+    let logits = eng.read_last_logits()?;
+    let mut f = fs::File::create(&a[4])?;
+    for x in logits {
+        f.write_all(&x.to_le_bytes())?;
+    }
+    println!("position={} top={next}", n - 1);
+    Ok(())
+}
