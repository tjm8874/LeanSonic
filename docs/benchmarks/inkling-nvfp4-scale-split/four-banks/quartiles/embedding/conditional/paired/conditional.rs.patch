+        let (both, rest) = left.split_at_mut(right.len());
+        for (i, (x, y)) in both.iter_mut().zip(right.iter_mut()).enumerate() {
+            a.group(i, x)?;
+            b.group(i, y)?;
+        }
+        for (i, out) in rest.iter_mut().enumerate() {
+            a.group(i + right.len(), out)?;
+        }
+        b.finish()?;
+    } else {
+        for (i, out) in left.iter_mut().enumerate() {
+            a.group(i, out)?;
+        }
+    }
