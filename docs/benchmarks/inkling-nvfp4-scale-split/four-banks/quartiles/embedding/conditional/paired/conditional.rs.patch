+fn decode_pair(frames: &[&[u8]], dst: &mut [MaybeUninit<u8>]) -> Result<(), String> {
+    let first_len = dst.len().min(TILE);
+    let (one, two) = dst.split_at_mut(first_len);
+    let mut a = Cursor::new(frames[0], one.len());
+    let left = one.as_chunks_mut::<8>().0;
